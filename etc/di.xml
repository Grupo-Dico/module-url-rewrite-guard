<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandList">
        <arguments><argument name="commands" xsi:type="array"><item name="dico_url_guard" xsi:type="object">GDMexico\UrlRewriteGuard\Console\Command\AuditAndRepair</item></argument></arguments>
    </type>
    <type name="Magento\CatalogUrlRewrite\Observer\CategoryProcessUrlRewriteSavingObserver">
        <plugin name="dico_auto_url_guard_category" type="GDMexico\UrlRewriteGuard\Plugin\BeforeCategoryUrlRewrite" sortOrder="1"/>
    </type>
    <type name="Magento\CatalogUrlRewrite\Observer\AfterImportDataObserver">
        <plugin name="dico_auto_url_guard_import" type="GDMexico\UrlRewriteGuard\Plugin\BeforeImportUrlRewrite" sortOrder="1"/>
    </type>
    <type name="Magento\ImportExport\Model\Import">
        <plugin name="dico_url_guard_prepare_csv" type="GDMexico\UrlRewriteGuard\Plugin\PrepareUploadedCsv" sortOrder="5"/>
    </type>
</config>
